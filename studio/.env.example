# Reports to Charts Studio — local environment variables
# Copy to studio/.env. Never commit real secrets.

# Mistral OCR (fallback)
MISTRAL_API_KEY=

# Azure Document Intelligence (primary)
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=

# MiniMax — Coding Plan (sk-cp-) or pay-as-you-go keys
# OpenAI-compatible: https://platform.minimax.io/docs/api-reference/text-openai-api
LLM_PROVIDER=openai_compatible
LLM_API_KEY=
LLM_BASE_URL=https://api.minimax.io/v1
LLM_MODEL=MiniMax-M3

# Chart council (3 MiniMax calls: strategist → planner → critic). Set false to disable.
# USE_CHART_COUNCIL=false

APP_ENV=development
