# Reports to Charts Studio environment variables
# Copy to .env locally. Never commit real secrets.

# MiniMax M3 — OpenAI-compatible LLM / multimodal
LLM_PROVIDER=openai_compatible
LLM_API_KEY=
LLM_BASE_URL=https://api.minimax.io/v1
LLM_MODEL=MiniMax-M3

# Mistral OCR
MISTRAL_API_KEY=

# Azure Document Intelligence
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=

# Railway deployment target reference; optional
RAILWAY_PROJECT_ID=

# App config
APP_ENV=development
UPLOAD_RETENTION=temporary
